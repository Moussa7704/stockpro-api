{
  "name": "stockpro-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "oxlint",
    "db": "tsx src/database/cli.ts",
    "db:migrate": "tsx src/database/cli.ts up",
    "db:migrate:undo": "tsx src/database/cli.ts down",
    "db:migrate:status": "tsx src/database/cli.ts pending && tsx src/database/cli.ts executed",
    "db:migration:create": "tsx src/database/cli.ts create --name",
    "db:migrate:prod": "node dist/database/cli.js up",
    "db:cleanup": "tsx src/scripts/cleanup.ts",
    "mail:verify": "tsx src/scripts/verify-mailer.ts",
    "user:create-admin": "tsx src/scripts/create-admin.ts"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.11.2",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "umzug": "^3.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "oxlint": "^1.87.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
