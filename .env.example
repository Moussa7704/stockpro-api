NODE_ENV=development
PORT=3000
TRUST_PROXY=0
# Sauvegardes (voir docs/SAUVEGARDES.md) : dossier, heure (variable TZ), outils PostgreSQL hors PATH,
# compte autorisé à créer une base pour la vérification
# BACKUP_DIR=backups
# BACKUP_HOUR=2
# PG_BIN_DIR=C:\Program Files\PostgreSQL\15\bin
in
# BACKUP_VERIFY_DB_USER=postgres
# BACKUP_VERIFY_DB_PASSWORD=
# Journal : debug (requêtes SQL comprises), info (défaut), warn, error ; silent en test
# LOG_LEVEL=info
# Documentation interactive sur /api/docs (Swagger UI) : active par défaut sauf si NODE_ENV=production
# API_DOCS_ENABLED=true
# Adresse du front (liens envoyés par email)
CLIENT_URL=http://localhost:5173

# Avec Docker (docker compose up), DB_HOST et DB_PORT sont remplacés par ceux du réseau Docker ;
# DB_NAME, DB_USER et DB_PASSWORD servent aussi à créer la base du conteneur PostgreSQL.
# Développer avec la base Docker seule (docker compose up -d db) : DB_HOST=localhost, DB_PORT=5433
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stockpro
DB_USER=stockpro_user
DB_PASSWORD=

# Port publié par docker compose pour l'API (3000 par défaut)
# API_PORT=3000

JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=900
REFRESH_TOKEN_TTL_DAYS=7

OTP_SECRET_KEY=

# Envoi des emails (Gmail : mot de passe d'application Google, pas celui du compte)
EMAIL_USER=
EMAIL_PASS=
# Facultatif (Gmail par défaut) :
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# MAIL_FROM="StockPro <adresse@gmail.com>"

# Tests automatisés (pnpm test) : compte PostgreSQL capable de créer la base stockpro_test
TEST_DB_USER=postgres
TEST_DB_PASSWORD=
